# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env.local for development or set these in your 
# deployment platform (Vercel, AWS, etc.) for production.
#
# NEVER commit actual secrets to version control.
# Use this file as a template only.
# ============================================================================

# ============================================================================
# AUTHENTICATION & NEXT.js
# ============================================================================

# NextAuth secret for session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-generated-secret-here-at-least-32-chars

# NextAuth URL (your domain)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# ============================================================================
# DATABASE
# ============================================================================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/supercollectiblespos
MONGODB_DB_NAME=supercollectiblespos

# Optional: Separate database for testing
TEST_MONGODB_URI=mongodb://localhost:27017/supercollectiblespos-test

# ============================================================================
# EMAIL SERVICE
# ============================================================================

# Email provider (sendgrid, mailgun, smtp, etc.)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Alternative: SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@supercollectibles.com
SMTP_FROM_NAME=Super Collectibles

# ============================================================================
# AUTHENTICATION PROVIDERS
# ============================================================================

# Google OAuth
GOOGLE_ID=your-google-oauth-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-oauth-secret

# GitHub OAuth (optional)
GITHUB_ID=your-github-oauth-id
GITHUB_SECRET=your-github-oauth-secret

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

# Stripe
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key

# ============================================================================
# CRON JOBS & AUTOMATION
# ============================================================================

# Secret for cron job requests (generate with: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-token-here

# Cron scheduler configuration
CRON_ENABLED=true
CRON_LOG_LEVEL=info

# ============================================================================
# TESTING
# ============================================================================

# Secret for E2E test endpoint (generate with: openssl rand -base64 32)
TEST_SECRET=your-test-secret-token-here

# Enable tests in non-production environments
TEST_ENABLED=true

# ============================================================================
# FILE STORAGE (MinIO)
# ============================================================================

# MinIO S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=supercollectibles
MINIO_USE_SSL=false

# Or use AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Google Analytics
NEXT_PUBLIC_GA_ID=G-your-google-analytics-id

# Sentry error tracking (optional)
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_PROJECT_ID=your-sentry-project-id
SENTRY_ORGANIZATION=your-sentry-org

# ============================================================================
# API KEYS & THIRD-PARTY SERVICES
# ============================================================================

# OpenAI (for AI features)
OPEN_AI_KEY=sk-your-openai-api-key

# TikTok API (for export features)
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Debug mode (enable extra logging)
DEBUG=false
DEBUG_API=false

# ============================================================================
# PERFORMANCE & CACHING
# ============================================================================

# Redis for session/cache (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Session expiration (in seconds, default 24 hours)
SESSION_MAX_AGE=86400

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# For production, override specific values:
# NODE_ENV=production
# NEXTAUTH_URL=https://supercollectibles.com
# NEXT_PUBLIC_APP_URL=https://supercollectibles.com
# MINIO_USE_SSL=true
# DEBUG=false
# TEST_ENABLED=false

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# 
# VERCEL:
#   1. Go to Project Settings → Environment Variables
#   2. Add each variable from this template
#   3. Set for Production environment
#   4. Redeploy
#
# AWS/DigitalOcean:
#   1. Create .env.production in deployment
#   2. Or set via platform environment variables
#   3. Restart application
#
# Docker:
#   1. Add to docker-compose.yml environment section
#   2. Or use .env file in container directory
#   3. Mount as volume if sensitive
#
# GitHub Actions CI/CD:
#   1. Go to Settings → Secrets and variables → Actions
#   2. Add each variable with VITE_ or NEXT_PUBLIC_ prefix
#   3. Reference in workflow: ${{ secrets.VARIABLE_NAME }}
#
